# Servidor
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ordenes_compra
DB_USER=root
DB_PASSWORD=tu_contraseña

# Autenticación (JWT)
# Clave secreta para firmar los tokens: mínimo 32 caracteres aleatorios.
# Genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Duración del token (formatos: 1h, 8h, 1d)
JWT_EXPIRES_IN=8h

# Asistente con IA (cerebro + agentes)
# Clave de la API de Anthropic: créala en https://platform.claude.com (Settings > API keys).
# Sin clave, el resto del sistema funciona igual; solo el asistente queda desactivado.
ANTHROPIC_API_KEY=
# Modelo que usan el cerebro y los agentes
ASISTENTE_MODELO=claude-opus-5-5

# Límites de uso
# Preguntas al asistente por minuto por usuario (cada pregunta cuesta dinero en la API)
LIMITE_ASISTENTE=10
# Intentos de inicio de sesión cada 15 minutos por IP
LIMITE_LOGIN=30

# Control de inventario (Quiz #2)
# Webhook entrante de Slack o Discord para avisos de reorden y el resumen diario.
# Vacío: las alertas quedan solo en la tabla alertas_reorden y en la consola.
ALERTAS_WEBHOOK_URL=
# Revisión diaria automática (reorden + duplicados): activar/desactivar y hora (HH:MM, hora del servidor)
TAREAS_ACTIVAS=true
TAREAS_HORA=07:00
# Regla de posibles compras duplicadas: días entre órdenes y diferencia de cantidad permitida (%)
DUPLICADOS_DIAS=7
DUPLICADOS_TOLERANCIA=10
# Días hacia atrás que revisa la tarea diaria (las órdenes aún abiertas se revisan siempre)
DUPLICADOS_VENTANA=30

# Matriz de aprobación: días hacia atrás y adelante en que se suman las órdenes del mismo
# departamento y proveedor para evaluar el monto (control contra el fraccionamiento)
APROBACION_VENTANA_DIAS=30
