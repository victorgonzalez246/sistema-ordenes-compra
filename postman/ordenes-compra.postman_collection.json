            {
              "name": "Crear sin campos obligatorios (400)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/proveedores",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "proveedores"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"telefono\": \"+58 212-555-0000\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status 400\", () => pm.response.to.have.status(400));",
                      "pm.test(\"Respuesta JSON con formato de error\", () => {",
                      "    pm.response.to.be.json;",
                      "    const r = pm.response.json();",
                      "    pm.expect(r).to.have.property(\"error\").that.is.a(\"string\").and.not.empty;",
                      "    pm.expect(r).to.have.property(\"detalles\").that.is.an(\"array\");",
                      "});",
                      "pm.test(\"Indica cada campo obligatorio faltante\", () => {",
                      "    const campos = pm.response.json().detalles.map((d) => d.campo);",
                      "    pm.expect(campos).to.include.members([\"razon_social\", \"rif\", \"email\"]);",
                      "});"
                    ]
                  }
                }
              ]
            },
