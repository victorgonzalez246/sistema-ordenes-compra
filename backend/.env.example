# Servidor
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ordenes_compra
DB_USER=root
DB_PASSWORD=tu_contraseña

# Autenticación (JWT)
# Clave secreta para firmar los tokens: mínimo 32 caracteres aleatorios.
# Genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Duración del token (formatos: 1h, 8h, 1d)
JWT_EXPIRES_IN=8h
